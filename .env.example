# Generic OpenAI-compatible provider configuration.
# OPENAI_API_KEY is still accepted as a backward-compatible fallback.
KIVI_LLM_API_KEY=
KIVI_LLM_MODEL=gpt-5-mini
KIVI_EMBEDDING_MODEL=text-embedding-3-small
KIVI_LLM_BASE_URL=https://api.openai.com/v1

# Optional retry tuning for transient provider failures (429/5xx/timeouts).
KIVI_LLM_MAX_RETRIES=3
KIVI_LLM_RETRY_BASE_SECONDS=0.6

# Optional. When true and no API key is present, the app uses deterministic demo logic.
KIVI_DEMO_MODE=true
KIVI_DB_PATH=./kivi.db

# Optional evaluation cost calculation for the selected provider/model.
KIVI_INPUT_COST_PER_1M=
KIVI_OUTPUT_COST_PER_1M=
